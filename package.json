{
  "name": "space-heroes",
  "version": "0.1.0",
  "description": "A Soldat-inspired 2D team shooter for the big screen. Phones are the controllers.",
  "type": "module",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "screenshots": "node scripts/screenshots.mjs",
    "check-maps": "node scripts/check-maps.mjs",
    "test-weapons": "node scripts/test-weapons.mjs",
    "voices:setup": "bash tools/voice/setup.sh",
    "voices": "node scripts/voices.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "nipplejs": "0.10.2",
    "qrcode": "1.5.4",
    "ws": "8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AkramYamin/kanab.git"
  },
  "homepage": "https://github.com/AkramYamin/kanab"
}
